# Copy this file to .env and fill in real values for local docker-compose use.
# .env is auto-loaded by `docker compose` and stays out of git.

# MySQL root password (shared by the mysql and app services)
DB_PASS=12345678

# Spring Security basic-auth user (guards /swagger-ui and actuator, not the DB)
SECURITY_USER=admin
SECURITY_PASS=changeme

# Econt delivery API (demo credentials are fine for local dev)
ECONT_URL=http://demo.econt.com/ee/services
ECONT_USER=iasp-dev
ECONT_PASS=1Asp-dev
